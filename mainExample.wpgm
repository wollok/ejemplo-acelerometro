import wollok.game.*
import controles.*

import jugador.*
import mapa.*
import niveles.*
 import controler.*

program tilt_maze {

  game.clear()
  game.title("El laberinto de la bolita")
  game.width(mapa.ancho())
  game.height(mapa.alto())
  
  celular.simularTeclas()
  mapa.iniciar(niveles.get(0))
  game.addVisual(bolita)

  keyboard.r().onPressDo({
    bolita.reiniciar()
  })

  controles.activar()

	sensor.register('A', { game.say(bolita, "HOLA!") })
	sensor.register('B', { game.say(bolita, "CHAU!") })
	sensor.register('C', { bolita.reiniciar() })

	game.start()
}
