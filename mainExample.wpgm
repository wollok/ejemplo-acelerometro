import jugador.*
import controles.*
import wollok.game.*

program PepitaGame {
	game.title("Acelerometro")
	game.height(10)
	game.width(10)

	celular.simularTeclas()
	game.addVisualCharacter(jugador)

	sensor.register('A', { game.say(jugador, "HOLA!") })
	sensor.register('B', { game.say(jugador, "CHAU!") })

	game.start()
}
